// use prisma-8

model User {
  id            Int           @id @default(autoincrement())
  email         String        @unique
  username      String?       @unique
  passwordHash  String
  spots SkateSpot[] @relation("SpotCreator")
  media         SpotMedia[]
  comments      SpotComment[]
  communityDescriptions SkateSpot[] @relation("CommunityDescriptionAuthor")
  communityDescriptionReports SpotCommunityDescriptionReport[]
  commentReports SpotCommentReport[]
  reports       SpotMediaReport[]
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()
  refreshTokens RefreshToken[]
}

model SkateSpot {
  id             Int           @id @default(autoincrement())
  name           String
  description    String?
  communityDescription          String?
  communityDescriptionAuthorId  Int?
  communityDescriptionUpdatedAt TimestamptzString?
  communityDescriptionReports SpotCommunityDescriptionReport[]
  address        String?
  latitude       Float
  longitude      Float

  // Identification de la source externe
  externalSource String?
  externalId     String?

  createdById    Int
    createdBy User @relation(
      "SpotCreator",
      fields: [createdById],
      references: [id]
    )

    communityDescriptionAuthor User? @relation(
      "CommunityDescriptionAuthor",
      fields: [communityDescriptionAuthorId],
      references: [id]
    )

  media          SpotMedia[]
  comments       SpotComment[]
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()

  // Un spot externe ne peut être importé qu'une seule fois
  @@unique([externalSource, externalId])
}

model SpotMedia {
  id               Int           @id @default(autoincrement())
  url              String
  type             String
  storageKey       String?
  moderationStatus String        @default("approved")
  moderationReason String?
  deletedAt        TimestamptzString?
  userId           Int
  spotId           Int
  user             User          @relation(fields: [userId], references: [id])
  spot             SkateSpot     @relation(fields: [spotId], references: [id])
  reports          SpotMediaReport[]
  createdAt        TimestamptzString @default(now())
}

model SpotMediaReport {
  id         Int           @id @default(autoincrement())
  mediaId    Int
  reporterId Int
  reason     String
  details    String?
  status     String        @default("pending")
  reviewedAt TimestamptzString?
  media      SpotMedia     @relation(fields: [mediaId], references: [id])
  reporter   User          @relation(fields: [reporterId], references: [id])
  createdAt  TimestamptzString @default(now())

    @@index([mediaId])
    @@index([reporterId])
    @@index([status])
}

model SpotComment {
  id        Int           @id @default(autoincrement())
  content   String
  userId    Int
  spotId    Int
  user      User          @relation(fields: [userId], references: [id])
  spot      SkateSpot     @relation(fields: [spotId], references: [id])
  createdAt TimestamptzString @default(now())
  reports SpotCommentReport[]
}

model RefreshToken {
  id        Int              @id @default(autoincrement())
  tokenHash String           @unique
  userId    Int
  user      User             @relation(fields: [userId], references: [id])
  expiresAt TimestamptzString
  createdAt TimestamptzString @default(now())
}

model SpotCommunityDescriptionReport {
  id                  Int           @id @default(autoincrement())
  spotId              Int
  reporterId          Int
  reason              String
  details             String?
  descriptionSnapshot String
  status              String        @default("pending")
  reviewedAt          TimestamptzString?
  createdAt           TimestamptzString @default(now())

  spot     SkateSpot @relation(fields: [spotId], references: [id])
  reporter User      @relation(fields: [reporterId], references: [id])

  @@index([spotId])
  @@index([reporterId])
  @@index([status])
}

model SpotCommentReport {
  id                  Int           @id @default(autoincrement())
  commentId           Int
  reporterId          Int
  reason              String
  details             String?
  contentSnapshot     String
  status              String        @default("pending")
  reviewedAt          TimestamptzString?
  createdAt           TimestamptzString @default(now())

  comment  SpotComment @relation(fields: [commentId], references: [id])
  reporter User        @relation(fields: [reporterId], references: [id])

  @@index([commentId])
  @@index([reporterId])
  @@index([status])
}